{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "-j8"
            ],
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/nemu"
            },
        },
        {
            "label": "Clean and Build with Bear gen complite.json",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "unset http_proxy && unset https_proxy && make clean && bear -- make -j8"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/nemu"
            },
            "problemMatcher": []
        }
    ]
}